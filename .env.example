TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Restrict access to specific Telegram user IDs (comma-separated, STRONGLY recommended)
# Find your ID via @userinfobot on Telegram
ALLOWED_USER_IDS=

# Working directory for command execution (defaults to home directory)
# Set to your project folder, e.g. /Users/yourname/projects/anda-tool
WORK_DIR=
